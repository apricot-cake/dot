---
interface Props {
  store?: 'microsoft' | 'chrome';
}
const { store } = Astro.props;
---
<div class="store-links">
  {store !== 'chrome' && <div class="store-placeholder"><span class="store-placeholder-name">Microsoft Store</span><span>公式バッジをここに配置</span></div>}
  {store !== 'microsoft' && <div class="store-placeholder"><span class="store-placeholder-name">Chrome ウェブストア</span><span>公式バッジをここに配置</span></div>}
</div>
