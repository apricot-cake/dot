---
import ReplayDemo from './ReplayDemo';
import FeatureVisual from './FeatureVisual';
import StoreLinks from './StoreLinks.astro';
import { Lock } from 'lucide-react';
import { getImage } from 'astro:assets';
import evernightArtwork from '../../public/demo/evernight-color.webp';
import ananArtwork from '../../public/demo/anan.webp';
import sherryArtwork from '../../public/demo/sherry.webp';
import originalArtwork from '../../public/demo/original-character-video.webp';
const authorThumbnails = Object.fromEntries(
  await Promise.all(
    (
      [
        ['anan', ananArtwork],
        ['sherry', sherryArtwork],
        ['original-character-video', originalArtwork],
      ] as const
    ).map(async ([id, artwork]) => {
      const image = await getImage({ src: artwork, width: 384, height: 384, fit: 'cover', format: 'png' });
      return [id, image.src];
    }),
  ),
);
const originVariants = await Promise.all([180, 360, 540].map((width) => getImage({ src: evernightArtwork, width, format: 'png' })));
const originImage = { src: originVariants[1].src, srcSet: originVariants.map((image, index) => `${image.src} ${[180, 360, 540][index]}w`).join(', '), width: evernightArtwork.width, height: evernightArtwork.height };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="hero section-wrap scroll-reveal">
  <h1><span>そのイラスト</span><span>投稿ごと残そう</span></h1>
  <p class="hero-intro"><span>画像だけ保存していると、あとから探すのが大変。</span><span>本文や作者も一緒に保存して、名前やキーワードで探せます。</span></p>
  <div class="hero-actions">
    <StoreLinks />
  </div>
</section>
<section id="demo" class="demo-section section-wrap scroll-reveal" aria-label="アプリの操作デモ">
  <ReplayDemo client:load base={base} />
</section>
<section class="feature-section section-wrap scroll-reveal">
  <div class="feature-copy">
    <h2>手がかりも一緒に</h2>
    <p>本文や作者、投稿へのリンク、反応数も保存します。保存したイラストから、投稿の内容をいつでも確認できます。</p>
  </div>
  <div class="feature-visual"><FeatureVisual mode="origin" base={base} originImage={originImage} /></div>
</section>
<section class="feature-section feature-reverse section-wrap scroll-reveal">
  <div class="feature-copy">
    <h2>タグで整理する</h2>
    <p>作品やキャラ、好きなタグで整理できます。手元のイラストもインポートして、同じライブラリにまとめられます。</p>
  </div>
  <div class="feature-visual"><FeatureVisual mode="organize" base={base} /></div>
</section>
<section class="feature-section section-wrap scroll-reveal">
  <div class="feature-copy">
    <h2>投稿者をまとめる</h2>
    <p>好きな作者のイラストをひとまとめに。保存した一枚から、その人のほかのイラストも見返せます。</p>
  </div>
  <div class="feature-visual"><FeatureVisual mode="authors" base={base} authorThumbnails={authorThumbnails} /></div>
</section>
<section class="support-section section-wrap scroll-reveal" aria-labelledby="support-heading">
  <h2 id="support-heading">対応サイトと保存できるもの</h2>
  <div class="supported-sources">
    <div>
      <h3>投稿ごと保存</h3>
      <p>X・Bluesky・pixiv の投稿に対応しています。本文や作者などの投稿情報も一緒に残せます。</p>
    </div>
    <div>
      <h3>Webの画像・動画</h3>
      <p>ほかのサイトの画像や動画も、右クリックから出典URLと一緒に保存できます。</p>
    </div>
    <div>
      <h3>手元の画像・動画</h3>
      <p>PCにあるファイルも取り込んで、同じライブラリで整理できます。</p>
    </div>
  </div>
</section>
<section class="local-section section-wrap scroll-reveal">
  <div class="local-icon" aria-hidden="true"><Lock size={58} strokeWidth={1.5} /></div>
  <div class="feature-copy">
    <h2>データはあなたのもの</h2>
    <p>アカウントを作らずに使えます。画像と投稿の情報は選んだフォルダーに保存するので、アプリを削除したあとも手元に残ります。</p>
  </div>
</section>
<section class="setup-section section-wrap scroll-reveal" aria-label="導入">
  <h2>使ってみる</h2>
  <p class="setup-availability">無料で使えるオープンソースのアプリです。</p>
  <p class="setup-requirement">WindowsアプリとChrome拡張機能を組み合わせて使います。</p>
  <StoreLinks />
</section>

<script>
  const sections = [...document.querySelectorAll<HTMLElement>('.scroll-reveal')];
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let observer: IntersectionObserver | undefined;
  const show = (section: HTMLElement) => {
    section.dataset.reveal = 'visible';
    observer?.unobserve(section);
  };
  const setup = () => {
    observer?.disconnect();
    if (motion.matches || !('IntersectionObserver' in window)) {
      sections.forEach(show);
      return;
    }
    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) show(entry.target as HTMLElement);
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0 });
    for (const section of sections) {
      if (section.dataset.reveal === 'visible') continue;
      section.dataset.reveal = 'pending';
      observer.observe(section);
    }
  };
  setup();
  motion.addEventListener('change', setup);
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof HTMLElement) {
      const section = event.target.closest<HTMLElement>('.scroll-reveal');
      if (section) show(section);
    }
  });
</script>
