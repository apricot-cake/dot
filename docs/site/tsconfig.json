{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["../../app/src/renderer/src/*"] },
    "types": ["astro/client", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [".astro/types.d.ts", "src/**/*", "playwright.config.ts", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}
