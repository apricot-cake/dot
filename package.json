{
  "name": "dot-dev",
  "private": true,
  "version": "0.0.0",
  "description": "dot development tooling",
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "classic-level": "^3.0.0",
    "fast-check": "^4.10.2",
    "intl-messageformat": "^12.1.3",
    "jsdom": "^30.1.2",
    "jszip": "3.10.2",
    "markdownlint-cli2": "0.23.3",
    "postcss": "^8.5.29",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "ws": "^8.22.0",
    "yazl": "^3.3.1"
  },
  "scripts": {
    "ext:build": "node scripts/build-extension.cts",
    "ext:build:test": "node scripts/build-test-extension.cts",
    "ext:deploy": "node scripts/deploy-extension.cts",
    "app:deploy": "node scripts/deploy-app.cts",
    "ext:dev:open": "node scripts/open-dev-profile.cts",
    "ext:dev:status": "node scripts/open-dev-profile.cts --print",
    "ext:dev:run": "node scripts/run-dev-browser.cts",
    "ext:dev:open:marker": "node scripts/open-dev-profile.cts --marker",
    "ext:dev:register": "node scripts/register-dev-native-host.cts",
    "ext:tokens": "node scripts/gen-extension-tokens.cts",
    "test:ext:overlay:visual": "pnpm run ext:build:test && playwright test --project=extension-regression overlay-visual",
    "test:ext:overlay:flicker": "pnpm run ext:build:test && playwright test --project=extension-regression overlay-flicker",
    "test:ext:hostile-css": "pnpm run ext:build:test && playwright test --project=extension-regression extension-hostile-css",
    "test:ext:orphan": "pnpm run ext:build:test && playwright test --project=extension-regression extension-orphan",
    "ext:package": "node scripts/zip-extension.cts",
    "setup": "node scripts/setup.cts",
    "lint": "biome check . && pnpm run lint:markdown && pnpm run lint:typos",
    "lint:ci": "biome ci . && pnpm run lint:markdown",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "lint:typos": "typos",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:content": "node scripts/guard-repository-content.cts --staged",
    "prepare:search-engine": "node scripts/prepare-meilisearch.mjs",
    "test": "vitest run",
    "test:ext": "pnpm run ext:build:test && vitest run --config vitest.extension.config.ts",
    "test:e2e:ci": "playwright test --project=flow --project=harness --project=extension",
    "test:e2e:app": "playwright test --project=flow",
    "test:e2e:regression": "playwright test --project=flow-regression --project=extension-regression --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "pnpm --dir extension run prepare:types && tsc -b",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "check:ext": "pnpm run check && pnpm run test:ext",
    "release:ext:verify": "pnpm run ext:build",
    "check:ci": "pnpm run prepare:search-engine && pnpm run lint:ci && pnpm run typecheck && pnpm test && pnpm run test:ext && pnpm run release:ext:verify",
    "test:e2e:harness": "playwright test --project=harness --workers=4",
    "test:e2e:process": "playwright test --project=harness --project=extension --workers=4",
    "test:integration": "pnpm run ext:build:test && playwright test --project=harness --project=extension --workers=4",
    "test:e2e:ext": "pnpm run ext:build:test && playwright test --project=extension --workers=4",
    "start": "pnpm run app:launch",
    "app:launch": "pnpm --filter @apricot-cake/dot run _launch",
    "app:debug": "node scripts/local-app.cts verify",
    "app:dev": "pnpm --filter @apricot-cake/dot run _dev",
    "app:build": "pnpm --filter @apricot-cake/dot run _build",
    "app:package": "pnpm --filter @apricot-cake/dot run _package",
    "app:make": "pnpm --filter @apricot-cake/dot run _make",
    "app:publish": "pnpm --filter @apricot-cake/dot run _publish",
    "diag:capture": "node scripts/summarize-capture-timings.cts",
    "diag:extension": "node scripts/read-extension-diagnostics.cts",
    "diag:api:collect": "node scripts/collect-api-responses.cts",
    "diag:api:replay": "node scripts/replay-api-responses.cts",
    "site:dev": "pnpm --dir docs/site run dev",
    "site:check": "pnpm --dir docs/site run check",
    "site:build": "pnpm --dir docs/site run build",
    "site:test": "pnpm --dir docs/site test"
  },
  "packageManager": "pnpm@12.11.2"
}
