{
  "name": "dot-extension",
  "private": true,
  "version": "0.1.0",
  "description": "dot browser extension (MV3), built by WXT",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:chrome",
    "build:chrome": "pnpm run tokens && wxt build -b chrome",
    "typecheck": "pnpm run prepare:types && tsc -b",
    "postinstall": "wxt prepare",
    "tokens": "node ../scripts/gen-extension-tokens.cts",
    "prepare:types": "wxt prepare"
  },
  "dependencies": {
    "@marbec/web-auto-extractor": "2.2.1",
    "entities": "8.1.0",
    "lucide": "^1.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "wxt": "0.21.4"
  }
}
