    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "viewerjs": "^1.15.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.19",
    "@tanstack/router-core": "^1.171.37",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "i18next": "^26.4.4",
    "i18next-icu": "^2.5.0",
    "image-size": "^2.0.4",
