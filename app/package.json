    "lucide-react": "^1.56.0",
    "meilisearch": "^0.62.0",
    "react-image-crop": "^11.1.2",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
