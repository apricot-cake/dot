{
  "name": "@apricot-cake/dot",
  "productName": "dot",
  "version": "1.1.0",
  "description": "dot desktop viewer",
  "repository": "https://github.com/apricot-cake/dot",
  "main": "./out/main/index.js",
  "author": "apricot-cake",
  "license": "MIT",
  "scripts": {
    "_launch": "node ../scripts/local-app.cts launch",
    "_build:theme-boot": "node build-theme-boot.mjs",
    "_build:native-host-bridge": "node build-native-host-bridge.mjs",
    "_prepare:avif": "node ../scripts/prepare-avif-validator.mjs",
    "_dev": "node ../scripts/prepare-meilisearch.mjs && pnpm run _prepare:avif && pnpm run _build:theme-boot && pnpm run _build:native-host-bridge && node ../scripts/dev-app.cts",
    "_build": "node ../scripts/prepare-meilisearch.mjs && pnpm run _prepare:avif && pnpm run _build:theme-boot && pnpm run _build:native-host-bridge && electron-vite build",
    "_package": "pnpm run _build && node ../scripts/package-app.cjs",
    "_make": "pnpm run _package && electron-forge make --from-package",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-msix": "8.0.1",
    "@tailwindcss/vite": "^4.3.2",
